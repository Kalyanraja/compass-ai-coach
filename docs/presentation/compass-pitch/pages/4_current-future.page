pageType: content
background:
  type: solid
  color: "$bg"
elements:
  - elementId: kicker
    elementType: text
    bounds: [80, 48, 500, 20]
    content:
      style: "$kicker"
      wrap: false
      text: "03 — CURRENT STATE VS FUTURE STATE"
  - elementId: table
    elementType: table
    bounds: [80, 92, 800, 356]
    columnWidths: [0.16, 0.42, 0.42]
    rowHeights: [0.12, 0.22, 0.22, 0.22, 0.22]
    style:
      cellStyle:
        fontSize: 12
        color: "$dim"
        lineHeight: 1.35
        align: [left, middle]
        border: [null, null, {style: solid, width: 1, color: "$line"}, null]
      firstRowStyle:
        color: "$primary"
        bold: true
        fontSize: 12
        letterSpacing: 1
        border: [null, null, {style: solid, width: 1, color: "$primary"}, null]
      firstColumnStyle:
        color: "$text"
        bold: true
        fontSize: 13
    rows:
      - - text: ""
        - text: "TODAY"
        - text: "WITH COMPASS"
      - - text: Engineer
        - text: "Has tools, little guidance. Picks the convenient tool, writes underspecified prompts, learns by trial and error."
        - text: "One evidence-backed next step, private. A complete prompt for the right tool in three clicks. Ready-made files in the repo."
      - - text: Manager
        - text: "Sees license and usage counts — or nothing. Risks drifting into individual monitoring."
        - text: "Team patterns shared by 5+ engineers, with a concrete enablement action and kit files."
      - - text: Leader
        - text: "Cannot tell whether the AI investment changes delivery."
        - text: "Portfolio patterns and practices associated with better signals — labeled non-causal, with a pilot plan."
      - - text: Enablement team
        - text: "Writes generic training for everyone."
        - text: "Targets enablement at observed gaps. Ships practices as files that work in every repo."
  - elementId: src
    elementType: text
    bounds: [80, 466, 800, 30]
    content:
      style: "$small"
      text: |
        <p>Full comparison: docs/business-case.md in the repository. Journey detail: docs/user-guide.md and docs/demo-script.md.</p>
  - elementId: pageno
    elementType: text
    bounds: [900, 500, 36, 16]
    content:
      style: "$small"
      align: [right, middle]
      wrap: false
      text: "04"
