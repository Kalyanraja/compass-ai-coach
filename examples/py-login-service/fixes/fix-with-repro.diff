+"""Regression test for LOGIN-7: wrong password of the same length (SYNTHETIC FIXTURE)."""
+
+import unittest
+
+from login_service.auth import authenticate, make_user
+
+
+class WrongPasswordRegressionTest(unittest.TestCase):
+    def setUp(self):
+        self.users = {"demo.user": make_user("Correct-Horse-1")}
+
+    def test_same_length_wrong_password_is_rejected(self):
+        self.assertFalse(authenticate("demo.user", "Wrong-Battery-9", self.users))
+
+    def test_different_length_wrong_password_is_rejected(self):
+        self.assertFalse(authenticate("demo.user", "short", self.users))
+
+    def test_correct_password_still_accepted(self):
+        self.assertTrue(authenticate("demo.user", "Correct-Horse-1", self.users))
