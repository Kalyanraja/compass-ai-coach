  "prompt_coach_stories": [
    {
      "id": "J01",
      "text": "Build REST API to create a service request. As a portal user I want to submit a request. Given a valid request when POST /requests then 201.",
      "expected_type": "feature_api",
      "expected_tool": "copilot"
    },
    {
      "id": "J02",
      "text": "Order summary API fails in UAT with 500 for some customers, works in dev.",
      "expected_type": "bug_fix",
      "expected_tool": "claude"
    },
    {
      "id": "J03",
      "text": "Create Playwright tests for the login page before release.",
      "expected_type": "test_creation",
      "expected_tool": "copilot"
    },
    {
      "id": "J04",
      "text": "Upgrade all services to Java 21 and fix deprecations across all services.",
      "expected_type": "refactor_modernization",
      "expected_tool": "devin"
    },
    {
      "id": "J05",
      "text": "Write a status update email for leadership about the sprint.",
      "expected_type": "docs_communication",
      "expected_tool": "copilot"
    },
    {
      "id": "J06",
      "text": "Fix formatting and lint warnings in the utils package.",
      "expected_type": "trivial_deterministic",
      "expected_tool": "no_ai"
    },
    {
      "id": "J07",
      "text": "Add unit tests with xUnit for the InvoiceCalculator edge cases: empty invoice, negative totals.",
      "expected_type": "test_creation",
      "expected_tool": "copilot"
    },
    {
      "id": "J08",
      "text": "Explain how the payment retry module works and where the backoff is configured.",
      "expected_type": "exploration",
      "expected_tool": "claude"
    },
    {
      "id": "J09",
      "text": "Review my pull request before I request review from the team.",
      "expected_type": "pr_readiness",
      "expected_tool": "copilot"
    },
    {
      "id": "J10",
      "text": "Optimize the stored procedure usp_GetClaims; the query on the claims table takes 40 seconds.",
      "expected_type": "data_sql",
      "expected_tool": "copilot"
    },
    {
      "id": "J11",
      "text": "NullPointerException in CustomerController when the address is missing. Expected a 400 instead.",
      "expected_type": "bug_fix",
      "expected_tool": "claude"
    },
    {
      "id": "J12",
      "text": "Refactor the ReportService class to extract the PDF generation into its own component, no behavior change.",
      "expected_type": "refactor_modernization",
      "expected_tool": "claude"
    },
    {
      "id": "J13",
      "text": "Bump the logging dependency in every service across all repos to the patched version.",
      "expected_type": "refactor_modernization",
      "expected_tool": "devin"
    },
    {
      "id": "J14",
      "text": "Add a new endpoint GET /vendors/{id}/contacts returning name and role, 404 if vendor missing.",
      "expected_type": "feature_api",
      "expected_tool": "copilot"
    },
    {
      "id": "J15",
      "text": "Design and implement end-to-end order cancellation across the order, payment and notification services.",
      "expected_type": "feature_api",
      "expected_tool": "claude"
    },
    {
      "id": "J16",
      "text": "Summarize this design doc for the stakeholders meeting in five bullet points.",
      "expected_type": "docs_communication",
      "expected_tool": "copilot"
    }
  ]
